{
  "name": "vtools",
  "type": "module",
  "version": "1.0.0",
  "private": "true",
  "packageManager": "pnpm@10.23.0",
  "description": "",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "main": "index.js",
  "scripts": {
    "commitlint": "commitlint --edit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "preinstall": "npx only-allow pnpm",
    "dev": "tsdown --config=tsdown.config.dev.ts",
    "build": "tsdown --config=tsdown.config.build.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.2",
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^16.3.3",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.21.2",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "pnpm commitlint"
  },
  "lint-staged": {
    "*": [
      "eslint --fix"
    ]
  }
}
