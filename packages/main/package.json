{
  "name": "veltools",
  "type": "module",
  "version": "1.0.0",
  "description": "配置驱动的 Vue 组件工具库，基于 Vue 3 + Element Plus",
  "author": "gk",
  "license": "MIT",
  "homepage": "https://github.com/wujighostking/vtools#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wujighostking/vtools",
    "directory": "packages/main"
  },
  "bugs": "https://github.com/wujighostking/vtools/issues",
  "keywords": ["vue", "vue3", "form", "table", "element-plus", "component"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --minify",
    "dev": "tsdown --sourcemap --watch=src"
  },
  "peerDependencies": {
    "element-plus": ">=2.0.0",
    "vue": ">=3.0.0"
  },
  "dependencies": {
    "@veltools/form": "workspace:*",
    "@veltools/table": "workspace:*"
  },
  "devDependencies": {
    "element-plus": "^2.13.5",
    "vue": "^3.5.30"
  }
}
